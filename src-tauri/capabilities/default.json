{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Least-privilege capability for the DevTrace main window: core APIs, showing, focusing and theming the window, and exactly the application commands listed in build.rs. No file system, shell, dialog, HTTP or shortcut plugin permission is granted; other windows (the hidden PDF printing window) get nothing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-theme",
    "allow-get-app-info",
    "allow-reveal-data-directory",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-overview",
    "allow-list-projects",
    "allow-get-project",
    "allow-create-project",
    "allow-update-project",
    "allow-delete-project",
    "allow-list-sessions",
    "allow-get-session",
    "allow-create-session",
    "allow-update-session",
    "allow-update-session-notes",
    "allow-set-session-status",
    "allow-delete-session",
    "allow-list-events",
    "allow-create-event",
    "allow-update-event",
    "allow-delete-event",
    "allow-import-image",
    "allow-update-annotations",
    "allow-delete-attachment",
    "allow-review-events",
    "allow-reorder-events",
    "allow-redact-attachment",
    "allow-get-review-summary",
    "allow-list-review-decisions",
    "allow-mark-session-reviewed",
    "allow-reopen-session-review",
    "allow-get-capture-status",
    "allow-list-capture-targets",
    "allow-start-capture",
    "allow-set-auto-capture-enabled",
    "allow-pause-capture",
    "allow-resume-capture",
    "allow-stop-capture",
    "allow-capture-now",
    "allow-list-playbooks",
    "allow-get-playbook",
    "allow-create-playbook",
    "allow-create-playbook-from-session",
    "allow-save-playbook",
    "allow-set-playbook-status",
    "allow-delete-playbook",
    "allow-get-playbook-revision",
    "allow-get-playbook-restore-point",
    "allow-restore-playbook-version",
    "allow-set-playbook-outdated",
    "allow-duplicate-playbook",
    "allow-export-playbook",
    "allow-reveal-export",
    "allow-list-changes",
    "allow-declare-change",
    "allow-update-change",
    "allow-review-change",
    "allow-verify-change",
    "allow-delete-change",
    "allow-start-terminal-log",
    "allow-stop-terminal-log",
    "allow-get-terminal-log",
    "allow-watch-config-file",
    "allow-stop-config-watch",
    "allow-list-config-watches",
    "allow-list-integrations",
    "allow-create-backup",
    "allow-reveal-backup",
    "allow-choose-backup",
    "allow-restore-backup"
  ]
}
